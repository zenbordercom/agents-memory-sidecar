[Unit]
Description=Encrypted PostgreSQL backup for Agent Memory
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=agents-memory
Group=agents-memory
WorkingDirectory=/opt/agents-memory-sidecar
ExecStart=/opt/agents-memory-sidecar/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
