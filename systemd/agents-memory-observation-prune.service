[Unit]
Description=Prune expired Agent Memory observations
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=agents-memory
Group=agents-memory
WorkingDirectory=/opt/agents-memory-sidecar
EnvironmentFile=/etc/agents-memory/sidecar.env
ExecStart=/usr/bin/env node /opt/agents-memory-sidecar/scripts/prune-observations.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
