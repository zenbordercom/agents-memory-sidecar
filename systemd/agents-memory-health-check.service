[Unit]
Description=Agent Memory read-only health check
After=agents-memory-sidecar.service postgresql.service
OnFailure=agents-memory-health-check-failure.service

[Service]
Type=oneshot
User=agents-memory
Group=agents-memory
Environment=AGENT_MEMORY_CONFIG_FILE=/etc/agents-memory/sidecar.env
ExecStart=/usr/bin/env node /opt/agents-memory-sidecar/scripts/health-check.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/agents-memory-sidecar /etc/agents-memory /var/backups/agents-memory
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
