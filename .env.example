AGENT_MEMORY_BACKEND=fake
AGENT_MEMORY_STORE_PATH=data/fake-store.json
AGENT_MEMORY_AGENT_ID=local-agent
AGENT_MEMORY_RUNTIME=local
AGENT_MEMORY_ROLE=writer
AGENT_MEMORY_TENANT=default
AGENT_MEMORY_PROJECTS=*

# HTTP sidecar
AGENT_MEMORY_HTTP_HOST=127.0.0.1
AGENT_MEMORY_HTTP_PORT=18790
AGENT_MEMORY_HTTP_BASE_URL=http://127.0.0.1:18790
# Required for production: token registry file or JSON. Startup fails closed without one.
AGENT_MEMORY_HTTP_TOKENS_FILE=/etc/agents-memory/http-tokens.json
# AGENT_MEMORY_HTTP_TOKENS_JSON=
# Demo/test only: tokenless mode on loopback bind hosts (127.0.0.1, ::1, localhost).
# Never enable this for non-loopback binds; startup will refuse.
# AGENT_MEMORY_ALLOW_UNAUTHENTICATED_LOCAL=1

# PostgreSQL backend
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=agent_memory
PGUSER=agent_memory_app
PGPASSWORD=change-me
